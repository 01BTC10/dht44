# Copy to deploy/umami/.env and fill in. Do NOT commit the real .env.

# Postgres password for the umami DB user. Generate with: openssl rand -hex 24
UMAMI_DB_PASSWORD=changeme-32-bytes-of-random-hex

# App secret used to sign Umami sessions/JWTs. Must be random + secret.
# Generate with: openssl rand -hex 32
UMAMI_APP_SECRET=changeme-64-bytes-of-random-hex
